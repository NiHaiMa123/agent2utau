<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>a2u-bridge</AssemblyName>
    <RootNamespace>Agent2Utau.Bridge</RootNamespace>
    <Version>0.1.0</Version>
    <!-- OpenUtau install dir; override with /p:OuDir="..." -->
    <OuDir Condition="'$(OuDir)' == ''">E:\software\OpenUtau-win-x64 (6)</OuDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenUtau.Core">
      <HintPath>$(OuDir)\OpenUtau.Core.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Core">
      <HintPath>$(OuDir)\NAudio.Core.dll</HintPath>
    </Reference>
    <Reference Include="Serilog">
      <HintPath>$(OuDir)\Serilog.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Sinks.File">
      <HintPath>$(OuDir)\Serilog.Sinks.File.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Encoding.CodePages">
      <HintPath>$(OuDir)\System.Text.Encoding.CodePages.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
