    type: Numerical
    min: 0
    max: 16
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  dir:
    name: direct
    abbr: dir
    type: Options
    min: 0
    max: 1
    default_value: 0
    is_flag: false
    options:
    - 'false'
    - 'true'
    skip_output_if_default: false
  shft:
    name: tone shift
    abbr: shft
