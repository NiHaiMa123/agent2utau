    abbr: cl01
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl02:
    name: voice color Yousa_Cute
    abbr: cl02
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
