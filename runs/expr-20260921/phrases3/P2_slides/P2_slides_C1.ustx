    abbr: ene
    type: Curve
    min: -100
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  pexp:
    name: pitch expressiveness (curve)
    abbr: pexp
    type: Curve
    min: 0
    max: 100
    default_value: 100
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl01:
    name: voice color Yousa_Bright
    abbr: cl01
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl02:
    name: voice color Yousa_Cute
    abbr: cl02
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl03:
    name: voice color Yousa_Normal
    abbr: cl03
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl04:
    name: voice color Yousa_Whisper
    abbr: cl04
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl05:
    name: voice color Yousa_Classic
    abbr: cl05
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  clry:
    name: voice color y
    abbr: clry
    type: Options
    min: 0
    max: -1
