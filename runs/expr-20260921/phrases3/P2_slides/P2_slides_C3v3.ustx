    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
    skip_output_if_default: false
  cl05:
    name: voice color Yousa_Classic
    abbr: cl05
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ''
