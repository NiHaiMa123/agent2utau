    min: 0
    max: 1
    default_value: 0
    is_flag: false
    options:
    - ''
    - worldline
    skip_output_if_default: false
  vel:
    name: velocity
    abbr: vel
    type: Numerical
    min: 0
    max: 200
    default_value: 100
    is_flag: false
    flag: ''
    skip_output_if_default: false
